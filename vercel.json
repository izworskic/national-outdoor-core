{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/national-tools/smoke/_api",
      "destination": "/api/national-smoke-window"
    },
    {
      "source": "/national-tools/smoke/_assets/:path*",
      "destination": "/assets/:path*"
    }
  ]
}
